{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dayzsandbox.local/schemas/scene.schema.json",
  "title": "DayZ Sandbox Scene Document v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "doc_id",
    "name",
    "map",
    "ambiente",
    "entities",
    "cameras",
    "next"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "dsbx.scene/1"
    },
    "doc_id": {
      "type": "string",
      "pattern": "^d-[0-9a-f]{8}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "map": {
      "type": "string",
      "const": "chernarusplus"
    },
    "ambiente": {
      "$ref": "#/$defs/ambiente"
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "cameras": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/camera"
      }
    },
    "next": {
      "$ref": "#/$defs/nextCounters"
    }
  },
  "$defs": {
    "coord": {
      "type": "number",
      "minimum": 0,
      "maximum": 15360
    },
    "ambiente": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fecha",
        "hora",
        "nubes",
        "niebla",
        "lluvia",
        "viento"
      ],
      "properties": {
        "fecha": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "hora": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "nubes": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "niebla": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "lluvia": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "viento": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        }
      }
    },
    "mark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "z"
      ],
      "properties": {
        "x": {
          "$ref": "#/$defs/coord"
        },
        "z": {
          "$ref": "#/$defs/coord"
        }
      }
    },
    "gesture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "emote"
      ],
      "properties": {
        "emote": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "integer",
          "minimum": 1
        },
        "t": {
          "type": "number",
          "minimum": 0
        }
      },
      "oneOf": [
        {
          "required": [
            "at"
          ],
          "not": {
            "required": [
              "t"
            ]
          }
        },
        {
          "required": [
            "t"
          ],
          "not": {
            "required": [
              "at"
            ]
          }
        }
      ]
    },
    "actorEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "cls",
        "name",
        "x",
        "z",
        "yaw",
        "wardrobe",
        "behaviour",
        "roam",
        "marks",
        "gestures"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^act-(0[1-9]|[1-9]\\d+)$"
        },
        "kind": {
          "type": "string",
          "const": "actor"
        },
        "cls": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "$ref": "#/$defs/coord"
        },
        "z": {
          "$ref": "#/$defs/coord"
        },
        "yaw": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "wardrobe": {
          "type": "string",
          "minLength": 1
        },
        "behaviour": {
          "type": "string",
          "enum": [
            "HOLD",
            "ONCE",
            "LOOP",
            "ROAM"
          ]
        },
        "roam": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mark"
          }
        },
        "gestures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gesture"
          }
        }
      }
    },
    "nonActorEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "cls",
        "name",
        "x",
        "z",
        "yaw"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(obj|zmb|ani)-(0[1-9]|[1-9]\\d+)$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "objeto",
            "infectado",
            "animal"
          ]
        },
        "cls": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "$ref": "#/$defs/coord"
        },
        "z": {
          "$ref": "#/$defs/coord"
        },
        "yaw": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        }
      }
    },
    "entity": {
      "oneOf": [
        {
          "$ref": "#/$defs/actorEntity"
        },
        {
          "$ref": "#/$defs/nonActorEntity"
        }
      ]
    },
    "cameraKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "t",
        "x",
        "y",
        "z",
        "yaw",
        "pitch",
        "fov",
        "focus"
      ],
      "properties": {
        "t": {
          "type": "number",
          "minimum": 0
        },
        "x": {
          "$ref": "#/$defs/coord"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "$ref": "#/$defs/coord"
        },
        "yaw": {
          "type": "number",
          "minimum": -180,
          "exclusiveMaximum": 360
        },
        "pitch": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "fov": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 180
        },
        "focus": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "keys"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^cam-(0[1-9]|[1-9]\\d+)$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/cameraKey"
          }
        }
      }
    },
    "nextCounters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "act",
        "obj",
        "zmb",
        "ani",
        "cam"
      ],
      "properties": {
        "act": {
          "type": "integer",
          "minimum": 1
        },
        "obj": {
          "type": "integer",
          "minimum": 1
        },
        "zmb": {
          "type": "integer",
          "minimum": 1
        },
        "ani": {
          "type": "integer",
          "minimum": 1
        },
        "cam": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
